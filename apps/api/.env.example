# Application
DEBUG=false
ENVIRONMENT=development

# Database (Supabase)
DATABASE_URL=postgresql://user:password@host:5432/database
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Redis
REDIS_URL=redis://localhost:6379/0

# AI APIs (Backend orchestration only - services have their own)
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
GOOGLE_API_KEY=

# Services (internal communication)
ACTUARIAL_ENGINE_URL=http://actuarial-engine:8001
PBM_ENGINE_URL=http://pbm-engine:8002
RISK_ENGINE_URL=http://risk-engine:8003
REPORTING_ENGINE_URL=http://reporting-engine:8004
AI_AGENTS_URL=http://ai-agents:8005

# Security
JWT_SECRET_KEY=your-secret-key-change-in-production
JWT_ALGORITHM=HS256
JWT_EXPIRATION_MINUTES=60

# CORS
CORS_ORIGINS=http://localhost:3000,https://your-domain.com

# Monitoring
PROMETHEUS_ENABLED=true
LOG_LEVEL=INFO